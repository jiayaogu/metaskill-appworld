+            "X-ReMe-Attempt-Kind": self.identity.get("attempt_kind", ""),
+            "X-ReMe-Owner-Token": self.identity.get("owner_token", ""),
+            "X-ReMe-Owner-Generation": str(self.identity.get("ownership_generation", "")),
