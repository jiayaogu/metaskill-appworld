+
+    @service.http_service.post("/audit/snapshot")
+    async def snapshot():
+        store = service.service_context.vector_stores["default"]
+        nodes = await store.list()
+        count = await store.client.count(index=store.collection_name)
+        if count["count"] != len(nodes):
